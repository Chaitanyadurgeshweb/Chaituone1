# Copy this file to `.env` and fill in the values. Do NOT commit your `.env` file — keep it private.

# Supabase project URL (Settings → API → Project URL)
# Example: https://xyzabc.supabase.co
SUPABASE_URL=

# Supabase anon/public key (safe for browser builds)
# Find under Settings → API → anon key
SUPABASE_ANON_KEY=

# Supabase service role key (SERVER ONLY — do NOT expose or commit)
# Find under Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Supabase storage bucket name (create under Storage → Buckets)
# Example: nms-uploads
SUPABASE_BUCKET=

# Maximum allowed upload size in bytes (optional). Default = 50 MB
# 50 MB = 52428800
MAX_UPLOAD_BYTES=52428800

# Optional Vite build-time variables (useful for local dev / client build)
# If you use Vite, copy the corresponding values above into these fields.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=

# Quick notes:
# 1) After creating `.env` locally, run: npm install && npm run dev
# 2) Add `.env` to your .gitignore so secrets are not committed.
# 3) In production (Vercel), add the SAME variable names in Project → Settings → Environment Variables.
